{
  "name": "hayat-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && shx mkdir -p dist/certs && shx cp -r certs/* dist/certs/ && shx cp pass.json dist/pass.json",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "shx rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "bridge": "tsx server/gateBridge.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "idb-keyval": "^6.2.5",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "open-location-code": "^1.0.3",
    "passkit-generator": "^3.5.7",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "inquirer": "^14.0.2",
    "node-forge": "^1.4.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
